{
  "items": [
    { "id": "gd-13e686b645a2570e", "language": "gd", "text": "Gàidhlig" },
    { "id": "gd-9ae7656f24c6aa5b", "language": "gd", "text": "mòran" },
    { "id": "gd-9a0a2f167ba9308e", "language": "gd", "text": "taigh" },
    { "id": "gd-f6c1f5638cdcea4b", "language": "gd", "text": "Madainn mhath" },
    { "id": "gd-c266c3fabb1767fe", "language": "gd", "text": "Feasgar math" },
    { "id": "gd-9b9df2db12343072", "language": "gd", "text": "Tìoraidh" },
    { "id": "gd-f1f091f677dc301c", "language": "gd", "text": "Is mise Ana" },
    { "id": "gd-066c4b5b039807bf", "language": "gd", "text": "Dè an t-ainm a th' ort?" },
    { "id": "gd-5b7c92ac94d7ae7f", "language": "gd", "text": "'S e Ana an t-ainm a th' orm" },
    { "id": "gd-d75cac8a41ee8d25", "language": "gd", "text": "Tha mi gu math" },
    { "id": "gd-4ccf7425659a8e25", "language": "gd", "text": "Chan eil mi sgìth" },
    { "id": "gd-f65e6ae79bfc89e0", "language": "gd", "text": "A bheil thu deiseil?" },
    { "id": "gd-f33b962ad83e6f01", "language": "gd", "text": "Cò às a tha thu?" },
    { "id": "gd-882ea4f76b25adf9", "language": "gd", "text": "Tha mi à Alba" },
    { "id": "gd-a3c6a7943b274ee2", "language": "gd", "text": "Tha mi a' fuireach ann an Alba" },
    { "id": "gd-517631a622d9d234", "language": "gd", "text": "aon, dhà, trì" },
    { "id": "gd-59685f0880eeb6aa", "language": "gd", "text": "ceithir, còig, sia" },
    { "id": "gd-9a8ab31023fb2d31", "language": "gd", "text": "Tha mi fichead bliadhna a dh'aois" },
    { "id": "gd-502f334383d8b903", "language": "gd", "text": "Tha bràthair agam" },
    { "id": "gd-391997a8644d226b", "language": "gd", "text": "Tha piuthar agam" },
    { "id": "gd-711081cd168d1483", "language": "gd", "text": "Tha cù agad" },
    { "id": "gd-80b4c3123bc95b3e", "language": "gd", "text": "Tha mi a' leughadh" },
    { "id": "gd-dee468b28a811311", "language": "gd", "text": "Tha mi ag obair" },
    { "id": "gd-ebcfda6a09b2d8a6", "language": "gd", "text": "Tha mi ag ionnsachadh Gàidhlig" },
    { "id": "gd-3853352b6340d33f", "language": "gd", "text": "Is toil leam tì" },
    { "id": "gd-c41680679aacabed", "language": "gd", "text": "Cha toil leam cofaidh" },
    { "id": "gd-dbc4f2e75bdc58b2", "language": "gd", "text": "An toil leat ceòl?" },
    { "id": "gd-361c37b0f7d684f4", "language": "gd", "text": "Bu toil leam tì" },
    { "id": "gd-19d039a326948811", "language": "gd", "text": "Mas e ur toil e" },
    { "id": "gd-62dbb96b5a298013", "language": "gd", "text": "Mòran taing" },
    { "id": "gd-de7d72d33e891ecd", "language": "gd", "text": "Càite a bheil am bus?" },
    { "id": "gd-25b26cd25e66a7fb", "language": "gd", "text": "Tha mi aig an taigh" },
    { "id": "gd-c39796f31e2ccb7d", "language": "gd", "text": "Tha mi a' dol dhachaigh" },
    { "id": "gd-7f17eff3234126ba", "language": "gd", "text": "Ciamar a tha thu?" },
    { "id": "gd-143705d3a2980355", "language": "gd", "text": "Chan eil mi a' tuigsinn" },
    { "id": "gd-fc3ae9b45e95ff8e", "language": "gd", "text": "Bruidhinn nas slaodaiche" },
    { "id": "gd-b30bcae018e05337", "language": "gd", "text": "mo mhàthair" },
    { "id": "gd-ae6b893ecea77622", "language": "gd", "text": "mo bhràthair" },
    { "id": "gd-45cc924e9610df04", "language": "gd", "text": "taigh beag" },
    { "id": "gd-1cb8b7f130588e65", "language": "gd", "text": "Bha mi sgìth an-dè" },
    { "id": "gd-558b9302fcb616ba", "language": "gd", "text": "Cha robh mi aig an taigh" },
    { "id": "gd-24836cd5415989fc", "language": "gd", "text": "An robh thu ag obair?" },
    { "id": "gd-6cf03875acced933", "language": "gd", "text": "Leugh mi leabhar" },
    { "id": "gd-f4caa0a2b7c74ef0", "language": "gd", "text": "Dh'ith mi aran" },
    { "id": "gd-728a6ab60a7e0986", "language": "gd", "text": "Chaidh mi dhachaigh" },
    { "id": "gd-b729003264b9ff41", "language": "gd", "text": "Tha mi air crìochnachadh" },
    { "id": "gd-b958ddcc88598351", "language": "gd", "text": "Tha mi air tì òl" },
    { "id": "gd-2389398cbdcb7923", "language": "gd", "text": "Chan eil mi air crìochnachadh" },
    { "id": "gd-50761458108d8373", "language": "gd", "text": "Bidh mi ag obair a-màireach" },
    { "id": "gd-83f06776305cf095", "language": "gd", "text": "Cha bhi mi aig an taigh" },
    { "id": "gd-5bb6456be8688e6d", "language": "gd", "text": "Am bi thu an seo?" },
    { "id": "gd-ff6183b2f9de4be0", "language": "gd", "text": "Is urrainn dhomh snàmh" },
    { "id": "gd-ea3e5b662b55e343", "language": "gd", "text": "Chan urrainn dhomh tighinn" },
    { "id": "gd-7683878bed3cae23", "language": "gd", "text": "Tha feum agam air cuideachadh" },
    { "id": "gd-966eb830b5f8e79e", "language": "gd", "text": "taigh mòr" },
    { "id": "gd-9334e03a8846baa7", "language": "gd", "text": "nighean bheag" },
    { "id": "gd-acb2c2e8679d41ab", "language": "gd", "text": "a' bhean" },
    { "id": "gd-d223cc520ccf9bb6", "language": "gd", "text": "Tha seo nas motha" },
    { "id": "gd-8e00b07511a81f8f", "language": "gd", "text": "Tha seo nas lugha" },
    { "id": "gd-0fb7959853525ae4", "language": "gd", "text": "Is fheàrr leam tì" },
    { "id": "gd-ff606a2865a95a01", "language": "gd", "text": "Tha mi tinn" },
    { "id": "gd-7d5494fae1fed115", "language": "gd", "text": "Tha an t-acras orm" },
    { "id": "gd-dc35905a7b0e3e29", "language": "gd", "text": "Tha feum agam air dotair" },
    { "id": "gd-a112ae0450ff170b", "language": "gd", "text": "A bheil thu airson tighinn?" },
    { "id": "gd-98b7bfbfdea3f355", "language": "gd", "text": "Tha mi airson coiseachd" },
    { "id": "gd-6fd1867cfb829b4e", "language": "gd", "text": "Tha mi duilich" },
    { "id": "gd-faf1af047228365c", "language": "gd", "text": "Tha mi aig an taigh oir tha mi tinn" },
    { "id": "gd-f0cbc311b031e19f", "language": "gd", "text": "Tha mi sgìth ach tha mi gu math" },
    { "id": "gd-7f5705b1051c5d20", "language": "gd", "text": "An toiseach tì, an uair sin cofaidh" },
    { "id": "gd-be3c11c595560247", "language": "gd", "text": "Bha mi aig an taigh an-dè" },
    { "id": "gd-f03b77e69d94c1f9", "language": "gd", "text": "Tha mi ag obair an-diugh" },
    { "id": "gd-2e732c82ea7f2588", "language": "gd", "text": "Bidh mi an seo a-màireach" },
    { "id": "gd-baa7837588a6b6d1", "language": "gd", "text": "Madainn mhath. Is mise Ana. Dè an t-ainm a th' ort." },
    { "id": "gd-9d8b7d36c86d84ef", "language": "gd", "text": "Tha mi gu math. Cò às a tha thu. Tha mi fichead bliadhna a dh'aois." },
    { "id": "gd-e7dfffe318a95b9d", "language": "gd", "text": "Tha bràthair agam. Tha mi a' leughadh. Is toil leam tì." },
    { "id": "gd-41363dc6055e39b1", "language": "gd", "text": "Bu toil leam tì. Càite a bheil am bus. Ciamar a tha thu." },
    { "id": "gd-b477ec40128e606d", "language": "gd", "text": "Bha mi sgìth an-dè. Leugh mi leabhar. Tha mi air crìochnachadh." },
    { "id": "gd-7c495cc79be08729", "language": "gd", "text": "Tha mi air crìochnachadh. Bidh mi ag obair a-màireach. Tha feum agam air cuideachadh." },
    { "id": "gd-3ae2d21aaae11562", "language": "gd", "text": "taigh mòr. Tha seo nas motha. Tha mi tinn." },
    { "id": "gd-045b08fe400be525", "language": "gd", "text": "A bheil thu airson tighinn. Tha mi aig an taigh oir tha mi tinn. Bha mi aig an taigh an-dè." },
    { "id": "cy-ec43e481f8caaa20", "language": "cy", "text": "Cymru" },
    { "id": "cy-6e17abe5d19c928d", "language": "cy", "text": "Cymraeg" },
    { "id": "cy-085adb7e8e47c715", "language": "cy", "text": "tŷ" },
    { "id": "cy-cb87f9af2a17aec0", "language": "cy", "text": "Bore da" },
    { "id": "cy-be41e7b8d5d2a644", "language": "cy", "text": "Diolch" },
    { "id": "cy-8cd10cc5923e7a5e", "language": "cy", "text": "Hwyl fawr" },
    { "id": "cy-dc544b527f50a404", "language": "cy", "text": "Ana ydw i" },
    { "id": "cy-dcd0974fefbb9818", "language": "cy", "text": "Beth yw dy enw di?" },
    { "id": "cy-76ac5747c3ddc6bc", "language": "cy", "text": "Pwy wyt ti?" },
    { "id": "cy-b218784e5e06bd57", "language": "cy", "text": "Dw i'n dod o Gymru" },
    { "id": "cy-2536093da1816926", "language": "cy", "text": "Dw i'n byw yng Nghymru" },
    { "id": "cy-71ad9b5e12b3200e", "language": "cy", "text": "Dw i'n byw yma" },
    { "id": "cy-7ff3f29ab786974b", "language": "cy", "text": "Dw i'n hapus" },
    { "id": "cy-999d02ae0595644e", "language": "cy", "text": "Dw i ddim yn barod" },
    { "id": "cy-03cc8dcf2f2c3953", "language": "cy", "text": "Wyt ti'n barod?" },
    { "id": "cy-38b9229c5a131db8", "language": "cy", "text": "un, dau, tri" },
    { "id": "cy-1762defef27c1612", "language": "cy", "text": "pedwar, pump, chwech" },
    { "id": "cy-9f952c8b9fe16b1a", "language": "cy", "text": "Dw i'n ugain oed" },
    { "id": "cy-ff3596b7b4235191", "language": "cy", "text": "Mae gen i frawd" },
    { "id": "cy-84172cf2223e87b4", "language": "cy", "text": "Mae gen i chwaer" },
    { "id": "cy-ba3ed505467c715f", "language": "cy", "text": "Mae hi yma" },
    { "id": "cy-9af129fae16cb444", "language": "cy", "text": "Dw i'n dysgu Cymraeg" },
    { "id": "cy-fa888f8adbefc605", "language": "cy", "text": "Dw i'n gweithio bob dydd" },
    { "id": "cy-a9ea7fb22645b2b3", "language": "cy", "text": "Dw i'n darllen" },
    { "id": "cy-45ed76b4c98dd467", "language": "cy", "text": "Dw i'n hoffi te" },
    { "id": "cy-d76f3ad1c1fd8f0e", "language": "cy", "text": "Dw i ddim yn hoffi coffi" },
    { "id": "cy-ad3d9263aebd747a", "language": "cy", "text": "Dw i'n hoffi darllen" },
    { "id": "cy-2bb1a262e65ff3ef", "language": "cy", "text": "Ga i de?" },
    { "id": "cy-d796e2282ce68809", "language": "cy", "text": "Os gwelwch yn dda" },
    { "id": "cy-cf13e9521ec4f910", "language": "cy", "text": "Faint ydy hwn?" },
    { "id": "cy-f99b94e7f1ccc92e", "language": "cy", "text": "Ble mae'r orsaf?" },
    { "id": "cy-61de575d31011a12", "language": "cy", "text": "Dw i'n mynd adref" },
    { "id": "cy-6d5ffaf0c1dc360e", "language": "cy", "text": "Sut wyt ti?" },
    { "id": "cy-df90e6394c65a4d2", "language": "cy", "text": "Dw i ddim yn deall" },
    { "id": "cy-4ea7657df51608de", "language": "cy", "text": "Arafach, os gwelwch yn dda" },
    { "id": "cy-94139e1f3a5afaee", "language": "cy", "text": "o Gymru" },
    { "id": "cy-1f3bc15b94a24cae", "language": "cy", "text": "i Gaerdydd" },
    { "id": "cy-421ac4bd90e91fba", "language": "cy", "text": "dy dad" },
    { "id": "cy-97f0189ea421356e", "language": "cy", "text": "Roeddwn i'n flinedig ddoe" },
    { "id": "cy-3c4a0c633b629efc", "language": "cy", "text": "Roeddwn i gartref neithiwr" },
    { "id": "cy-74b680881138659c", "language": "cy", "text": "Doeddwn i ddim yn barod" },
    { "id": "cy-d6e0c0baa7971fc1", "language": "cy", "text": "Es i adref" },
    { "id": "cy-b3e146f92a3dcfcd", "language": "cy", "text": "Wnes i ddarllen ddoe" },
    { "id": "cy-d3652ce0f5a5c83b", "language": "cy", "text": "Wnes i ddim gweithio" },
    { "id": "cy-63373cb45dfd67cd", "language": "cy", "text": "Dw i wedi bwyta" },
    { "id": "cy-f9eb9d7f4ae4e9fa", "language": "cy", "text": "Dw i wedi gorffen" },
    { "id": "cy-5066c67e1c9c058f", "language": "cy", "text": "Dw i ddim wedi gorffen eto" },
    { "id": "cy-d49a30dcad01c912", "language": "cy", "text": "Bydda i'n gweithio yfory" },
    { "id": "cy-a1edd8aacfda8f12", "language": "cy", "text": "Bydda i gartref" },
    { "id": "cy-3f2485d138382b55", "language": "cy", "text": "Dw i'n mynd i weithio" },
    { "id": "cy-aadec688b5eb887a", "language": "cy", "text": "Galla i ddarllen" },
    { "id": "cy-95071f48b615b20c", "language": "cy", "text": "Dw i angen help" },
    { "id": "cy-2f852279eb9326cb", "language": "cy", "text": "Allwch chi helpu?" },
    { "id": "cy-88b09f55370c73d1", "language": "cy", "text": "tŷ mawr" },
    { "id": "cy-3465175c840f280f", "language": "cy", "text": "merch fach" },
    { "id": "cy-ddf940b06c21b8c7", "language": "cy", "text": "Mae'r tŷ yn fawr" },
    { "id": "cy-99ce086b45da0819", "language": "cy", "text": "Mae hwn yn fwy" },
    { "id": "cy-296b55db74fd39c0", "language": "cy", "text": "Mae hwn yn llai" },
    { "id": "cy-618ee0134cca9aae", "language": "cy", "text": "Mae'n well gen i de" },
    { "id": "cy-7d1af69c0c54ecf0", "language": "cy", "text": "Dw i'n sâl" },
    { "id": "cy-0df70ebf9d5aa949", "language": "cy", "text": "Mae pen tost gyda fi" },
    { "id": "cy-5140ceec4b421fad", "language": "cy", "text": "Dw i angen meddyg" },
    { "id": "cy-f6880bafb61e5080", "language": "cy", "text": "Wyt ti eisiau dod?" },
    { "id": "cy-9a61a399d784a99e", "language": "cy", "text": "Dw i ddim yn gallu dod" },
    { "id": "cy-84f12df5bba7391a", "language": "cy", "text": "Mae'n ddrwg gen i" },
    { "id": "cy-8c55297b9383986b", "language": "cy", "text": "Dw i'n aros achos dw i'n flinedig" },
    { "id": "cy-1654d077de04a081", "language": "cy", "text": "Dw i'n hoffi te ond dw i ddim yn hoffi coffi" },
    { "id": "cy-3a5de9df4cea8807", "language": "cy", "text": "Bwyta yn gyntaf, wedyn darllen" },
    { "id": "cy-cdf6bcde57e29e29", "language": "cy", "text": "Es i i Gaerdydd ddoe" },
    { "id": "cy-03fe4b9429986609", "language": "cy", "text": "Dw i gartref heddiw" },
    { "id": "cy-43ea88fdc27f7b7c", "language": "cy", "text": "Bore da. Ana ydw i. Beth yw dy enw di." },
    { "id": "cy-08461225612afcc1", "language": "cy", "text": "Dw i'n dod o Gymru. Dw i'n hapus. Dw i'n ugain oed." },
    { "id": "cy-8b22f55f87022908", "language": "cy", "text": "Mae gen i frawd. Dw i'n dysgu Cymraeg. Dw i'n hoffi te." },
    { "id": "cy-bd4bf96ccb6b7651", "language": "cy", "text": "Ga i de. Ble mae'r orsaf. Sut wyt ti." },
    { "id": "cy-3f97a56cea1c9450", "language": "cy", "text": "Roeddwn i'n flinedig ddoe. Es i adref. Dw i wedi bwyta." },
    { "id": "cy-2a632bd44b3b829f", "language": "cy", "text": "Dw i wedi bwyta. Bydda i'n gweithio yfory. Allwch chi helpu." },
    { "id": "cy-38c66cd1c12d1d9c", "language": "cy", "text": "tŷ mawr. Mae hwn yn fwy. Dw i'n sâl." },
    { "id": "cy-73d0b44b1040788f", "language": "cy", "text": "Wyt ti eisiau dod. Dw i'n aros achos dw i'n flinedig. Es i i Gaerdydd ddoe." }
  ]
}
